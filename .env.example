# STAI configuration — copy to .env and edit, or set as environment variables.
# Every setting in src/stai/config.py is overridable with the STAI_ prefix.
# Defaults are tuned for a local dev machine. A deployed policy turn requires
# all three configured models plus an active Chroma build; there is no
# disabled-agent or local answer fallback mode.

# --- Ollama models (must be pulled: `ollama pull <name>`) ---
STAI_AGENT_MODEL=llama3.1:8b
# Optional: use a smaller local model for typed finalization.
# STAI_FINALIZER_MODEL=qwen2.5:3b-instruct
# Guardrail classifier; keep separately configurable for demo hardware.
STAI_GUARDRAIL_MODEL=qwen2.5:3b-instruct
STAI_EMBED_MODEL=nomic-embed-text
# From a Linux container, use a private host/container address reachable from
# the application (for example http://host.docker.internal:11434 when mapped).
STAI_OLLAMA_BASE_URL=http://localhost:11434
STAI_AGENT_TEMPERATURE=0
STAI_AGENT_SEED=20260810
STAI_AGENT_PROBE_TIMEOUT_SECONDS=3
STAI_AGENT_REQUEST_TIMEOUT_SECONDS=90
STAI_AGENT_RECURSION_LIMIT=32
STAI_AGENT_MODEL_CALL_LIMIT=6
STAI_AGENT_CONTEXT_WINDOW=8192

# --- RAG ---
STAI_RETRIEVER_K=4

# --- Observability ---
# One schema-v2 privacy-safe record per top-level operation. No Hire IDs,
# prompts, answers, policy IDs, snippets, filenames, OCR, or raw errors.
STAI_OBS_LOG_PATH=data/observability.jsonl

# --- Log shipping to a remote MLflow relay (see src/stai/log_shipper.py) ---
# Leave STAI_LOG_SERVER_URL unset to disable shipping entirely.
# STAI_LOG_SERVER_URL=http://<relay-host>:8080/log-batch
# STAI_LOG_SHARED_SECRET=change-me
# STAI_LOG_SHIP_INTERVAL_SECONDS=300
