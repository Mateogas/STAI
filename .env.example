# STAI configuration — copy to .env and edit, or set as environment variables.
# Every setting in src/stai/config.py is overridable with the STAI_ prefix.
# Defaults are tuned for a local dev machine; on the demo cloud box you may
# only need to change the model names.

# --- Ollama models (must be pulled: `ollama pull <name>`) ---
STAI_AGENT_MODEL=llama3.1:8b
# Guardrail + pulse classifier. llama3.2:1b is faster but over-blocks
# benefits jargon (8/15 vs 15/15 on the topic battery).
STAI_GUARDRAIL_MODEL=qwen2.5:3b-instruct
STAI_EMBED_MODEL=nomic-embed-text
STAI_OLLAMA_BASE_URL=http://localhost:11434
STAI_AGENT_TEMPERATURE=0.2

# --- RAG ---
STAI_RETRIEVER_K=4
STAI_CHUNK_SIZE=800
STAI_CHUNK_OVERLAP=100

# --- Pulse check-ins ---
STAI_PULSE_CADENCE_DAYS=7

# --- Observability ---
# Every chat turn (Streamlit and API) is appended here as one JSON line:
# route, models, token estimates, latency, tools, sources, errors.
STAI_OBS_LOG_PATH=data/observability.jsonl
